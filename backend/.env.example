# ─── Django Security & Hosts ───────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-minimum-50-chars-secret-key-here-change-in-production-required
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.toofreshtowaste.in

# ─── Persistent Database (PostgreSQL) ──────────────────────────────────────────
# If omitted or left blank, local SQLite (db.sqlite3) is used as default dev fallback
DB_NAME=tftw_db
DB_USER=tftw_user
DB_PASSWORD=your-secure-postgres-password
DB_HOST=your-postgres-host.internal
DB_PORT=5432

# ─── CORS & Frontend URLs ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5500,https://toofreshtowaste.in,https://app.toofreshtowaste.com
# URL used in email links and Google OAuth redirects
FRONTEND_URL=https://toofreshtowaste.in

# ─── Email Service ─────────────────────────────────────────────────────────────
# Options: resend, sendgrid, smtp
EMAIL_PROVIDER=resend
# API key for Resend (https://resend.com) or SendGrid (https://sendgrid.com)
EMAIL_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Sender address (must be a verified domain in Resend/SendGrid)
EMAIL_FROM=Too Fresh To Waste <noreply@toofreshtowaste.in>
# Django email backend (use console.EmailBackend in local dev)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# ─── Google OAuth 2.0 ──────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/
# Application type: Web application
# Authorized redirect URIs: https://api.toofreshtowaste.in/api/auth/google/callback/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_REDIRECT_URI=https://api.toofreshtowaste.in/api/auth/google/callback/

# ─── Redis (Optional / Production Multi-Worker Scaling) ────────────────────────
# Used for Django Channels and rate-limit cache in production
REDIS_URL=redis://localhost:6379/0

# ─── Razorpay Payment Gateway (Test Mode / Live Mode) ───────────────────────────
# Get credentials from https://dashboard.razorpay.com/#/app/keys
# In Test Mode: starts with rzp_test_...
# In Live Mode: starts with rzp_live_...
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret configured in Razorpay Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=

