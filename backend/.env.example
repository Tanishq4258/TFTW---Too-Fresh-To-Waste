# ─── Django Security & Hosts ───────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-minimum-32-chars-secret-key-here-change-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.toofreshtowaste.com

# ─── Persistent Database (PostgreSQL) ──────────────────────────────────────────
# If omitted or left blank, local SQLite (db.sqlite3) is used as default dev fallback
DB_NAME=tftw_db
DB_USER=tftw_user
DB_PASSWORD=your-secure-postgres-password
DB_HOST=your-postgres-host.internal
DB_PORT=5432

# ─── CORS & Frontend URLs ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5500,https://toofreshtowaste.com,https://app.toofreshtowaste.com

# ─── Redis (Optional / Production Multi-Worker Scaling) ────────────────────────
REDIS_URL=redis://localhost:6379/0

