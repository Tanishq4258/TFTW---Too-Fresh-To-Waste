# Too Fresh To Waste (TFTW) — Environment Variables Example
# Copy this file to backend/.env and fill in your actual credentials.
# NEVER commit .env or secrets to Git.

# ─── Razorpay Payment Gateway (Test Mode / Live Mode) ───────────────────────────
# Keys obtained from: https://dashboard.razorpay.com/#/app/keys
# Test Mode keys start with rzp_test_...
# Live Mode keys start with rzp_live_...
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
